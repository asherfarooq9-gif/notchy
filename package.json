{
  "name": "windows-notch",
  "version": "0.1.0",
  "description": "A Dynamic-Island style notch with a Batman face for Windows",
  "main": "main.js",
  "author": "asherfarooq9-gif",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4"
  },
  "build": {
    "appId": "com.windowsnotch.app",
    "productName": "Notch",
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "preload.js",
      "panel-preload.js",
      "settings-preload.js",
      "lib/**",
      "renderer/**",
      "scripts/**",
      "!scripts/make-*.js",
      "assets/**",
      "!assets/icon.ico",
      "package.json"
    ],
    "asarUnpack": ["scripts/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Notch"
    }
  }
}
