{
  "name": "windows-notch",
  "version": "0.2.9",
  "description": "Notchy: a Dynamic-Island style notch for Windows with a tool panel, timers, music, screen glow and character looks (Electron)",
  "main": "main.js",
  "author": "asherfarooq9-gif",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4"
  },
  "build": {
    "appId": "com.windowsnotch.app",
    "productName": "Notchy",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "panel-preload.js",
      "settings-preload.js",
      "welcome-preload.js",
      "ambient-preload.js",
      "lib/**",
      "renderer/**",
      "scripts/**",
      "!scripts/make-*.js",
      "assets/**",
      "!assets/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notchy",
      "uninstallDisplayName": "Notchy",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Notchy-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "asherfarooq9-gif",
        "repo": "notchy",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright (c) 2026 asherfarooq9-gif. MIT License."
  },
  "homepage": "https://github.com/asherfarooq9-gif/notchy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asherfarooq9-gif/notchy.git"
  },
  "bugs": {
    "url": "https://github.com/asherfarooq9-gif/notchy/issues"
  },
  "keywords": [
    "electron",
    "windows",
    "notch",
    "notchy",
    "dynamic-island",
    "productivity"
  ]
}
